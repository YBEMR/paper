# 本机运行环境、偏好目录和临时工作区（包含 MATLAB 本机证书）
.runtime*/
/.vscode/
/.idea/
/.codex/
/.agents/
/.aws/
/tmp/
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
.pytest_cache/

# 凭据与本机配置
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
id_rsa*
id_ed25519*

# 文献目录仅跟踪根目录下的 PDF；其他下载、模型和原始二进制结果留在本机
/papers/*
*.pdf
*.mat
*.fig
*.tflite
*.onnx
*.pt
*.pth
*.zip
*.7z
*.crdownload
*.part
!/papers/*.pdf

# 师兄参考论文原文；不放行本项目正文编译产物。
!/main.pdf

# 文献页面渲染可以从原 PDF 重建；正文插图与实验结果图仍然跟踪
/research/extracted/*.png
/research/page_checks/
/research/evidence_*/**/*.png
!/research/latex/figures/**/*.pdf

# LaTeX 编译中间文件；保留 tex、bib、样式、正文插图和手工版本
/research/latex/build/
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.synctex.gz
*.run.xml
*.toc
*.lof
*.lot
*.nav
*.snm
*.vrb
/research/latex/**/*.log
/research/latex/**/*.out

# 编辑器／系统临时文件；不全局忽略实验日志、CSV、JSON 或源码快照
*.asv
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
