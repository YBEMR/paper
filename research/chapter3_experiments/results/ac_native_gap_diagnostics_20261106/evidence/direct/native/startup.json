{
  "version": "23.2.0.2365128 (R2023b)",
  "release": "2023b",
  "optimization_toolbox": {
    "Name": "Optimization Toolbox",
    "Version": "23.2",
    "Release": "(R2023b)",
    "Date": "01-Aug-2023"
  },
  "intlinprog_which": "${MATLAB_ROOT}\\toolbox\\optim\\optim\\intlinprog.m",
  "options": {
    "AbsoluteGapTolerance": 0,
    "BranchRule": "reliability",
    "ConstraintTolerance": 1e-09,
    "CutGeneration": "basic",
    "CutMaxIterations": 10,
    "Display": "iter",
    "Heuristics": "basic",
    "HeuristicsMaxNodes": 50,
    "IntegerPreprocess": "none",
    "IntegerTolerance": 1e-06,
    "LPMaxIterations": "max(30000,10*(numberOfEqualities+numberOfInequalities+numberOfVariables))",
    "LPOptimalityTolerance": 1e-07,
    "MaxNodes": 10000000.0,
    "MaxFeasiblePoints": null,
    "MaxTime": 300,
    "NodeSelection": "simplebestproj",
    "ObjectiveCutOff": null,
    "ObjectiveImprovementThreshold": 0,
    "OutputFcn": "ac_native_repro/observe",
    "PlotFcn": [],
    "RelativeGapTolerance": 0,
    "RootLPAlgorithm": "dual-simplex",
    "RootLPMaxIterations": "max(30000,10*(numberOfEqualities+numberOfInequalities+numberOfVariables))",
    "LPPreprocess": "none"
  },
  "MaxFeasiblePoints_is_Inf": true,
  "scope": "single direct same-array reproduction, not a formal optimization experiment"
}
