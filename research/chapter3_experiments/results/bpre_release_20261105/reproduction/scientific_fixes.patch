@@ -22,7 +24,31 @@ from run_milp_precheck import fixtures
 HERE = Path(__file__).resolve().parent
 
 
+@contextmanager
+def mock_worker_process(**kwargs):
+    """Replace only the controller's subprocess binding, never the global module.
+
+    platform.platform() may independently invoke subprocess.run on Linux.
+    Those metadata probes must not enter the experiment-worker mock.
+    """
+    worker = Mock(**kwargs)
+    interface = SimpleNamespace(run=worker, STDOUT=subprocess.STDOUT,
+                               CREATE_NO_WINDOW=getattr(subprocess, 'CREATE_NO_WINDOW', 0))
+    with patch.object(driver, 'subprocess', interface):
+        yield worker
+
+
 class DriverTests(unittest.TestCase):
+    def test_worker_mock_leaves_global_subprocess_untouched(self):
+        real_run = subprocess.run
+        original_binding = driver.subprocess
+        with mock_worker_process(return_value=SimpleNamespace(returncode=0)) as worker:
+            self.assertIs(subprocess.run, real_run)
+            self.assertIs(driver.subprocess.run, worker)
+            self.assertEqual(driver.subprocess.STDOUT, subprocess.STDOUT)
+            worker.assert_not_called()
+        self.assertIs(driver.subprocess, original_binding)
+
     @classmethod
     def setUpClass(cls):
         cls.config = load_config()
