{
  "normalization": "ID-keyed dictionaries for named lists; @order preserves list identity/order; remaining arrays compared whole",
  "config": [
    {
      "path": "/conditions/@items/bpre_recovered",
      "op": "remove",
      "before": {
        "id": "bpre_recovered",
        "group": "precheck_only",
        "overrides": {}
      }
    },
    {
      "path": "/conditions/@items/six115_control",
      "op": "add",
      "after": {
        "id": "six115_control",
        "group": "controlled_input_preparation_only",
        "overrides": {}
      }
    },
    {
      "path": "/conditions/@order",
      "op": "replace",
      "before": [
