      ],
      "after": [
        "six115_control"
      ]
    },
    {
      "path": "/controlled_deadline_policy",
      "op": "add",
      "after": {
        "kind": "explicit_fixed_relative_deadlines",
        "relative_ms_by_application": {
          "A": "90",
          "B": "115",
          "C": "90"
        },
        "uniform_beta": false,
        "effective_ratio_to_retained_CPU_H_chain": {
          "A": "1",
          "B": "23/20",
          "C": "1"
        },
        "purpose": "remove B.pre while holding the seven-execution anchor deadlines fixed"
      }
    },
    {
      "path": "/defaults/deadline_beta",
      "op": "replace",
      "before": "1",
      "after": null
    },
    {
      "path": "/defaults/deadline_reference",
      "op": "replace",
      "before": "scaled highest-frequency CPU chain length; independent of response variant",
      "after": "explicit fixed relative deadlines A=90,B=115,C=90 ms; not a uniform beta rule"
    },
    {
      "path": "/preparation_contract",
      "op": "add",
